# PetPlaybook assessment — environment variables
# Copy to .env for local development. Never commit the real .env file.

# ---- Application ----
NODE_ENV=development
PORT=3000
# Public base URL of this deployment, used to build sitemap/robots URLs.
PUBLIC_URL=http://localhost:3000

# ---- Supabase (server-only — never expose these to the browser) ----
# Project Settings -> API in the Supabase dashboard.
SUPABASE_URL=
# Project Settings -> API -> service_role secret key. Bypasses Row Level
# Security — required for all server-side reads/writes to waitlist and
# assessment_responses. Keep this out of source control and the browser
# bundle entirely.
SUPABASE_SECRET_KEY=

# ---- Admin auth (server-only) ----
# Password required to sign in at /admin.
ADMIN_PASSWORD=
# Random secret used to sign the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---- Email (optional) ----
# If unset, outbound email (waitlist team notification, contact form) is
# disabled: the waitlist signup still succeeds and saves to the database;
# the contact form will return an error until this is configured.
# API key from https://resend.com — Resend account -> API Keys.
RESEND_API_KEY=
# Verified sender address/domain in Resend, e.g. "PetPlaybook <notifications@petplaybook.com>"
EMAIL_FROM=

# ---- Embedding ----
# Space-separated CSP frame-ancestors sources allowed to iframe this app
# (never applies to /admin). Defaults to petplaybook.com if unset.
# FRAME_ANCESTORS='self' https://petplaybook.com https://www.petplaybook.com

# ---- Browser-facing (only if client-side Supabase access is ever added) ----
# Not currently used — the app reads/writes Supabase exclusively through
# server API routes. Uncomment only if a future feature needs direct
# browser access to Supabase.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
